---
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const skills = [
  {
    id: 'a11y-guard',
    name: 'a11y-guard',
    summary: 'Use it when an interface needs a serious accessibility pass before it ships.',
    description: 'It checks the things that are easy to miss when you are focused on the visual result: semantic HTML, screen-reader feedback, keyboard navigation, focus states, and ARIA that actually matches the interaction.',
  },
  {
    id: 'codebase-onboarder',
    name: 'codebase-onboarder',
    summary: 'Use it when a file or module makes you spend more time decoding than changing.',
    description: 'It turns an unfamiliar codebase into a working mental model. The output traces data from input to output, names the important interfaces and dependencies, and calls out the coupling and footguns that usually surface six months too late.',
  },
  {
    id: 'dep-upgrade-plan',
    name: 'dep-upgrade-plan',
    summary: 'Use it before a package upgrade turns into an unplanned migration.',
    description: 'It compares the requested versions, finds deprecated APIs and changed configuration, and separates the work into an audit, codemods, manual refactors, and validation. The goal is a migration path you can defend before touching the lockfile.',
  },
  {
    id: 'eli5-stakeholder',
    name: 'eli5-stakeholder',
    summary: 'Use it when technical work needs to make sense outside the engineering team.',
    description: 'It translates architecture, technical debt, and incidents into consequences people can act on: user experience, stability, delivery speed, and cost. It also puts the quick fix next to the durable option instead of hiding the trade-off.',
  },
  {
    id: 'quiz-me',
    name: 'quiz-me',
    summary: 'Use it before committing to a design, specification, or large code change.',
    description: 'It asks the uncomfortable questions first. State, performance, scale, API boundaries, and developer experience are stress-tested in small rounds until the assumptions are explicit and the recommendation is production-ready.',
  },
  {
    id: 'smart-commit',
    name: 'smart-commit',
    summary: 'Use it as the last check before a staged diff becomes a commit.',
    description: 'It fails fast on debug residue, focused tests, temporary comments, and commented-out code. Once the diff is clean, it checks public TypeScript signatures and proposes a concise Conventional Commit message without creating the commit for you.',
  },
  {
    id: 'story-creator',
    name: 'story-creator',
    summary: 'Use it when rough notes need to become work someone can actually pick up.',
    description: 'It turns a Slack thread, idea, or short specification into an engineering ticket with context, affected interfaces, an implementation path, and acceptance criteria that cover the happy path and the edges.',
  },
  {
    id: 'webperf-audit',
    name: 'webperf-audit',
    summary: 'Use it when a frontend feels slower, heavier, or more fragile than it should.',
    description: 'It looks for render bottlenecks, bundle bloat, layout shifts, async waterfalls, and expensive main-thread work. The result is a focused table of issues and fixes, not a vague instruction to “optimize performance.”',
  },
];
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mares Popa - Personal Website</title>
    <meta
      name="description"
      content="Senior Frontend Engineer modernizing architectures and CI/CD with React and TypeScript."
    />
    <GoogleAnalytics measurementId={"G-WY0KQ8W98H"} />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'system';
      const isDark = theme === 'dark' ||
        (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.setAttribute('data-theme-mode', theme);
    </script>
  </head>

  <body class="bg-[#f8f8f8] dark:bg-[#1a1a1a] text-[#111] dark:text-[#eee] font-mono selection:bg-[#007aff]/20 transition-colors duration-500 antialiased relative min-h-screen overflow-x-hidden">
    
    <!-- Soft animated background gradient blobs -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <div class="gradient-blob absolute -top-32 -left-20 w-[500px] h-[500px] rounded-full bg-gradient-to-br from-[#007aff]/15 via-indigo-500/10 to-transparent blur-3xl dark:from-[#3392ff]/15 dark:via-purple-500/10"></div>
      <div class="gradient-blob-2 absolute top-1/2 -right-32 w-[550px] h-[550px] rounded-full bg-gradient-to-tr from-cyan-500/10 via-[#007aff]/15 to-transparent blur-3xl dark:from-sky-500/10 dark:via-[#3392ff]/15"></div>
    </div>
    
    <div class="max-w-[640px] mx-auto px-8 py-20 md:py-40">
      
      <header class="flex justify-between items-baseline mb-16">
        <a href="/" class="text-sm font-bold tracking-tight hover:text-[#007aff] transition-colors">Mares Popa</a>
        <ThemeToggle />
      </header>

      <main class="space-y-24">
        <section>
          <p class="text-[26px] md:text-[30px] leading-[1.3] font-medium tracking-tight">
            Hi, I'm Mares.
          </p>
          <p class="mt-3 text-[15px] md:text-[16px] leading-[1.6] text-[#6b6b6b] dark:text-[#8a8a8a]">
            I'm a senior software engineer who enjoys turning complex ideas into thoughtful, easy-to-use websites and web apps, with a deep focus on UI/UX.
          </p>
        </section>

        <section class="space-y-8">
          <h2 class="text-xs font-bold text-[#0066cc] dark:text-[#3392ff] uppercase tracking-widest">Blog</h2>
          <div class="space-y-6">
            {posts.map(post => (
              <a href={`/blog/${post.id}`} class="group block no-underline">
                <div class="flex flex-col md:flex-row md:justify-between md:items-baseline gap-2">
                  <span class="text-[16px] group-hover:text-[#007aff] transition-colors underline decoration-transparent group-hover:decoration-[#007aff]/30 underline-offset-4">
                    {post.data.title}
                  </span>
                  <span class="text-[13px] text-[#6b6b6b] dark:text-[#8a8a8a] shrink-0">
                    {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.')}
                  </span>
                </div>
              </a>
            ))}
          </div>
          <a href="/blog" class="inline-block text-[13px] text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">
            All Posts →
          </a>
        </section>

        <section class="space-y-8">
          <h2 class="text-xs font-bold text-[#0066cc] dark:text-[#3392ff] uppercase tracking-widest">Projects</h2>
          <ul class="space-y-10">
            <li>
              <a href="https://github.com/marespopa/BaalTerminal" class="group">
                <span class="text-[16px] group-hover:text-[#007aff] transition-colors">BaalTerminal</span>
                <p class="text-[#6b6b6b] dark:text-[#8a8a8a] text-[14px] mt-2 leading-[1.6]">A high-performance, multi-tab terminal for full-screen TUI applications and streaming AI CLI workflows.</p>
              </a>
            </li>
            <li>
              <a href="https://www.hermesmarkdown.com" class="group">
                <span class="text-[16px] group-hover:text-[#007aff] transition-colors">Hermes Markdown</span>
                <p class="text-[#6b6b6b] dark:text-[#8a8a8a] text-[14px] mt-2 leading-[1.6]">A minimalist, local-first Markdown editor designed for deep work. No cloud. No tracking. Just the interface between your mind and the page.</p>
              </a>
            </li>
          </ul>
        </section>

        <section id="skills" class="space-y-8 scroll-mt-24">
          <h2 class="text-xs font-bold text-[#0066cc] dark:text-[#3392ff] uppercase tracking-widest">AI Skills</h2>
          <p class="text-[#6b6b6b] dark:text-[#8a8a8a] text-[14px] leading-[1.6]">
            A small collection of reusable prompts for the parts of engineering that need more than a quick answer: understanding a codebase, challenging a design, and getting the details right before delivery.
          </p>
          <div class="space-y-6 rounded-lg border border-[#eee] bg-white/60 p-5 dark:border-[#222] dark:bg-white/[0.03]">
            <div class="grid grid-cols-1 gap-x-10 gap-y-1 sm:grid-cols-2" role="tablist" aria-label="AI skills">
              {skills.map((skill) => (
                <button
                  id={`tab-${skill.id}`}
                  type="button"
                  role="tab"
                  aria-controls={`panel-${skill.id}`}
                  aria-selected="false"
                  tabindex={0}
                  class="skill-tab border-l-2 border-transparent px-3 py-2 text-left text-[13px] text-[#6b6b6b] transition-colors hover:border-[#007aff]/30 hover:text-[#007aff] dark:text-[#8a8a8a] dark:hover:border-[#3392ff]/30 dark:hover:text-[#3392ff]"
                  data-skill-tab={skill.id}
                >
                  {skill.name}
                </button>
              ))}
            </div>
            {skills.map((skill) => (
              <div
                id={`panel-${skill.id}`}
                role="tabpanel"
                aria-labelledby={`tab-${skill.id}`}
                tabindex="0"
                class="skill-panel hidden border-l-2 border-[#eee] pl-4 dark:border-[#222]"
                data-skill-panel={skill.id}
                hidden
              >
                <p class="text-[15px] leading-[1.6]">{skill.summary}</p>
                <p class="mt-3 text-[14px] leading-[1.7] text-[#6b6b6b] dark:text-[#8a8a8a]">{skill.description}</p>
              </div>
            ))}
          </div>
          <div class="flex flex-wrap gap-x-8 gap-y-3 text-[13px]">
            <a href="https://github.com/marespopa/marespopa/tree/master/skills" target="_blank" rel="noopener noreferrer" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">
              Browse on GitHub →
            </a>
            <a href="https://github.com/marespopa/marespopa/archive/refs/tags/skills-v1.0.2.zip" target="_blank" rel="noopener noreferrer" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">
              Download skills ZIP
            </a>
          </div>
        </section>

        <script>
          const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-skill-tab]'));
          const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-skill-panel]'));

          let activeSkillId: string | null = null;

          const activateSkill = (skillId: string | null, moveFocus = false) => {
            activeSkillId = skillId;

            tabs.forEach((tab) => {
              const isActive = tab.dataset.skillTab === skillId;
              tab.setAttribute('aria-selected', String(isActive));
              tab.tabIndex = isActive ? 0 : -1;
              tab.classList.toggle('border-[#007aff]', isActive);
              tab.classList.toggle('text-[#007aff]', isActive);
              tab.classList.toggle('dark:border-[#3392ff]', isActive);
              tab.classList.toggle('dark:text-[#3392ff]', isActive);
              tab.classList.toggle('border-transparent', !isActive);
              tab.classList.toggle('text-[#6b6b6b]', !isActive);
              tab.classList.toggle('dark:text-[#8a8a8a]', !isActive);
            });

            panels.forEach((panel) => {
              const isActive = panel.dataset.skillPanel === skillId;
              panel.hidden = !isActive;
              panel.classList.toggle('hidden', !isActive);
            });

            if (moveFocus && skillId) {
              tabs.find((tab) => tab.dataset.skillTab === skillId)?.focus();
            }
          };

          const selectedSkill = new URLSearchParams(window.location.search).get('skill');
          if (selectedSkill && tabs.some((tab) => tab.dataset.skillTab === selectedSkill)) {
            activateSkill(selectedSkill);
          }

          tabs.forEach((tab, index) => {
            tab.addEventListener('click', () => {
              const skillId = tab.dataset.skillTab ?? '';
              activateSkill(activeSkillId === skillId ? null : skillId);
            });
            tab.addEventListener('keydown', (event) => {
              const direction = event.key === 'ArrowRight' || event.key === 'ArrowDown'
                ? 1
                : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
                  ? -1
                  : 0;

              if (event.key === 'Home' || event.key === 'End') {
                event.preventDefault();
                const targetIndex = event.key === 'Home' ? 0 : tabs.length - 1;
                activateSkill(tabs[targetIndex].dataset.skillTab ?? '', true);
              } else if (direction) {
                event.preventDefault();
                const targetIndex = (index + direction + tabs.length) % tabs.length;
                activateSkill(tabs[targetIndex].dataset.skillTab ?? '', true);
              } else if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                const skillId = tab.dataset.skillTab ?? '';
                activateSkill(activeSkillId === skillId ? null : skillId);
              }
            });
          });
        </script>

        <section class="space-y-8">
          <h2 class="text-xs font-bold text-[#0066cc] dark:text-[#3392ff] uppercase tracking-widest">Music</h2>
          <ul class="space-y-10">
            <li>
              <a href="https://www.youtube.com/watch?v=bX8MdzaPg_E" class="group">
                <span class="text-[16px] group-hover:text-[#007aff] transition-colors">Shattered Sky / Shinra Tensei (Full Album)</span>
                <p class="text-[#6b6b6b] dark:text-[#8a8a8a] text-[14px] mt-2 leading-[1.6]">A post-atmospheric rock album</p>
              </a>
            </li>
          </ul>
        </section>

        <section class="space-y-8 border-t border-[#eee] dark:border-[#222] pt-12">
          <div class="flex gap-x-8 text-[13px]">
            <a href="mailto:office@marespopa.com" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">Email</a>
            <a href="https://www.linkedin.com/in/mares-popa/" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">LinkedIn</a>
            <a href="https://www.github.com/marespopa" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">GitHub</a>
            <a href="/resume" class="text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#007aff] dark:hover:text-[#3392ff] transition-colors">Resume</a>
          </div>
        </section>
      </main>

      <footer class="mt-32">
        <p class="text-[11px]">
          <a
            href="https://maps.google.com/?q=Cluj-Napoca,+Romania"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#0066cc] dark:text-[#3392ff] hover:underline transition-colors"
          >
            📍 Cluj-Napoca, Romania
          </a>
        </p>
        <p class="mt-2 text-[11px] text-[#6b6b6b] dark:text-[#8a8a8a]">Sorted {new Date().getFullYear()}</p>
      </footer>
    </div>

    <style>
      @keyframes float-slow {
        0%, 100% {
          transform: translate(0px, 0px) scale(1);
        }
        50% {
          transform: translate(40px, -30px) scale(1.08);
        }
      }
      @keyframes float-slow-reverse {
        0%, 100% {
          transform: translate(0px, 0px) scale(1);
        }
        50% {
          transform: translate(-35px, 25px) scale(1.06);
        }
      }
      .gradient-blob {
        animation: float-slow 16s ease-in-out infinite;
      }
      .gradient-blob-2 {
        animation: float-slow-reverse 20s ease-in-out infinite;
      }
    </style>

  </body>
</html>
