---
// Theme toggle component with soft, refined animations
// Cycles: light -> dark -> system (default)
---

<button
  id="theme-toggle"
  class="fixed top-6 right-6 z-50 p-2.5 rounded-full bg-white/80 dark:bg-[#242424]/80 backdrop-blur-md border border-[#eee] dark:border-[#333] text-[#6b6b6b] dark:text-[#8a8a8a] hover:text-[#111] dark:hover:text-[#eee] hover:border-[#ccc] dark:hover:border-[#555] shadow-xs hover:shadow-md transition-all duration-300 ease-out hover:scale-105 active:scale-95 group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#007aff]"
  aria-label="Toggle theme (light / dark / system)"
  title="Toggle theme (light / dark / system)"
>
  <div class="relative w-4 h-4 flex items-center justify-center">
    <!-- Sun icon for light mode -->
    <svg
      id="sun-icon"
      class="w-4 h-4 transition-transform duration-500 ease-out group-hover:rotate-45"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
    <!-- Moon icon for dark mode -->
    <svg
      id="moon-icon"
      class="w-4 h-4 hidden transition-transform duration-500 ease-out group-hover:-rotate-12"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
    <!-- Monitor icon for system mode -->
    <svg
      id="system-icon"
      class="w-4 h-4 hidden transition-transform duration-500 ease-out group-hover:scale-110"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
      <line x1="8" y1="21" x2="16" y2="21"></line>
      <line x1="12" y1="17" x2="12" y2="21"></line>
    </svg>
  </div>
</button>

<style>
  html[data-theme-mode="light"] #moon-icon,
  html[data-theme-mode="light"] #system-icon {
    display: none;
  }
  html[data-theme-mode="light"] #sun-icon {
    display: block;
  }
  html[data-theme-mode="dark"] #sun-icon,
  html[data-theme-mode="dark"] #system-icon {
    display: none;
  }
  html[data-theme-mode="dark"] #moon-icon {
    display: block;
  }
  html[data-theme-mode="system"] #sun-icon,
  html[data-theme-mode="system"] #moon-icon {
    display: none;
  }
  html[data-theme-mode="system"] #system-icon {
    display: block;
  }
</style>

<script>
  // Theme toggle functionality: cycles light -> dark -> system (default)
  function initTheme() {
    const themeToggle = document.getElementById('theme-toggle');
    const mql = window.matchMedia('(prefers-color-scheme: dark)');
    const order = ['light', 'dark', 'system'];

    // Saved preference, or 'system' by default
    const getStoredTheme = (): string => {
      if (typeof localStorage !== 'undefined') {
        return localStorage.getItem('theme') || 'system';
      }
      return 'system';
    };

    // Apply theme to document without persisting (used for live OS-change updates)
    const applyTheme = (theme: string) => {
      const isDark = theme === 'dark' || (theme === 'system' && mql.matches);
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.setAttribute('data-theme-mode', theme);
    };

    // Persist and apply
    const setTheme = (theme: string) => {
      localStorage.setItem('theme', theme);
      applyTheme(theme);
    };

    // Initialize theme
    applyTheme(getStoredTheme());

    // Keep in sync if the OS preference changes while "system" is active
    mql.addEventListener('change', () => {
      if (getStoredTheme() === 'system') applyTheme('system');
    });

    // Cycle theme on button click
    themeToggle?.addEventListener('click', () => {
      const currentTheme = getStoredTheme();
      const nextTheme = order[(order.indexOf(currentTheme) + 1) % order.length];
      
      // Gentle scale transition on click
      themeToggle.style.transform = 'scale(0.92)';
      setTimeout(() => {
        themeToggle.style.transform = '';
      }, 150);

      setTheme(nextTheme);
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheme);
  } else {
    initTheme();
  }
</script> 
