---
// Theme toggle component with brutalism design
// Cycles: light -> dark -> system (default)
---

<button
  id="theme-toggle"
  class="fixed top-4 right-4 z-50 p-3 bg-emerald-600 dark:bg-dark-800 border-2 border-black shadow-brutal hover:shadow-brutal-hover transition-all duration-200 transform hover:-translate-y-1 hover:translate-x-1"
  aria-label="Toggle theme (light / dark / system)"
>
  <!-- Sun icon for light mode -->
  <svg
    id="sun-icon"
    class="w-6 h-6 text-white"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      fill-rule="evenodd"
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      clip-rule="evenodd"
    ></path>
  </svg>
  <!-- Moon icon for dark mode -->
  <svg
    id="moon-icon"
    class="w-6 h-6 text-white hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
  </svg>
  <!-- Monitor icon for system mode -->
  <svg
    id="system-icon"
    class="w-6 h-6 text-white hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect x="3" y="4" width="18" height="12" rx="1" stroke-linecap="round" stroke-linejoin="round"></rect>
    <path d="M8 20h8M12 16v4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  html[data-theme-mode="light"] #moon-icon,
  html[data-theme-mode="light"] #system-icon {
    display: none;
  }
  html[data-theme-mode="light"] #sun-icon {
    display: block;
  }
  html[data-theme-mode="dark"] #sun-icon,
  html[data-theme-mode="dark"] #system-icon {
    display: none;
  }
  html[data-theme-mode="dark"] #moon-icon {
    display: block;
  }
  html[data-theme-mode="system"] #sun-icon,
  html[data-theme-mode="system"] #moon-icon {
    display: none;
  }
  html[data-theme-mode="system"] #system-icon {
    display: block;
  }
</style>

<script>
  // Theme toggle functionality: cycles light -> dark -> system (default)
  function initTheme() {
    const themeToggle = document.getElementById('theme-toggle');
    const mql = window.matchMedia('(prefers-color-scheme: dark)');
    const order = ['light', 'dark', 'system'];

    // Saved preference, or 'system' by default
    const getStoredTheme = (): string => {
      if (typeof localStorage !== 'undefined') {
        return localStorage.getItem('theme') || 'system';
      }
      return 'system';
    };

    // Apply theme to document without persisting (used for live OS-change updates)
    const applyTheme = (theme: string) => {
      const isDark = theme === 'dark' || (theme === 'system' && mql.matches);
      document.documentElement.classList.toggle('dark', isDark);
      document.documentElement.setAttribute('data-theme-mode', theme);
    };

    // Persist and apply
    const setTheme = (theme: string) => {
      localStorage.setItem('theme', theme);
      applyTheme(theme);
    };

    // Initialize theme
    applyTheme(getStoredTheme());

    // Keep in sync if the OS preference changes while "system" is active
    mql.addEventListener('change', () => {
      if (getStoredTheme() === 'system') applyTheme('system');
    });

    // Cycle theme on button click
    themeToggle?.addEventListener('click', () => {
      const currentTheme = getStoredTheme();
      const nextTheme = order[(order.indexOf(currentTheme) + 1) % order.length];
      setTheme(nextTheme);
    });

    // Add glitch effect on hover
    themeToggle?.addEventListener('mouseenter', () => {
      themeToggle.classList.add('animate-glitch');
    });

    themeToggle?.addEventListener('mouseleave', () => {
      themeToggle.classList.remove('animate-glitch');
    });
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheme);
  } else {
    initTheme();
  }
</script> 
